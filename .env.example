# Plantilla de variables. Los .env reales NO se suben al repo: copiá esto a
# `.env.development` (y a `.env.production` si vas a usar `pnpm dev:prod`) y
# completalo. Nada de acá es secreto: todo lo que empieza con VITE_ termina en
# el bundle y es público.

# --- .env.development (pnpm dev) -------------------------------------------
# URL del backend local.
VITE_API_URL=http://localhost:8080
# Solo para el cartel "Local / Producción" de la UI.
VITE_ENV_NAME=local

# --- .env.production (pnpm build y pnpm dev:prod) --------------------------
# VITE_ENV_NAME=production
# Vacía a propósito: la web llama a /api/... de su propio dominio y el hosting
# lo reenvía al backend (vercel.json). Si no se define, el build de producción
# usa vacía igual (ver src/api/config.ts).
# VITE_API_URL=
# Solo para `pnpm dev:prod`: a dónde reenvía /api el servidor de Vite. No es
# VITE_, así que no termina en el bundle.
# API_PROXY_TARGET=https://proyecto-gym-back-end-java-spring.onrender.com
